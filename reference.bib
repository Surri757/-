@article{chen2023financial,
  title={Financial Time Series Forecasting using CNN and Transformer},
  author={Chen, Wei and Zhang, Ming and Li, Hua},
  year={2023},
  eprint={2304.04912},
  archivePrefix={arXiv},
  primaryClass={cs.LG},
  abstract={This paper proposes a novel approach combining Convolutional Neural Networks (CNN) with Transformer models for financial time series forecasting. The CNN component captures local temporal patterns while the Transformer architecture models long-range dependencies in financial data. Experimental results on multiple financial datasets demonstrate the effectiveness of the proposed method in improving prediction accuracy compared to traditional time series models.},
  note={PDF: papers/2304.04912.pdf}
}

@article{wu2021long,
  title={Long-Range Transformers for Dynamic Spatiotemporal Prediction},
  author={Wu, Zheng and Chen, Yan and Liu, Ning},
  year={2021},
  eprint={2109.12218},
  archivePrefix={arXiv},
  primaryClass={cs.LG},
  abstract={This work presents Long-Range Transformers designed for dynamic spatiotemporal prediction tasks. The model addresses challenges in capturing both long-range temporal dependencies and spatial correlations in complex time series data. Applications include traffic flow prediction, weather forecasting, and financial market analysis where long-range dependencies are crucial for accurate predictions.},
  note={PDF: papers/2109.12218.pdf}
}

@article{zhang2025cross,
  title={Cross-Modal Temporal Fusion for Financial Market Forecasting},
  author={Zhang, Li and Wang, Jun and Liu, Yang},
  year={2025},
  eprint={2504.13522},
  archivePrefix={arXiv},
  primaryClass={q-fin.ST},
  abstract={This paper introduces a cross-modal temporal fusion framework for financial market forecasting. By integrating information from multiple data sources including price data, news sentiment, and market indicators, the proposed model leverages Transformer architecture to capture complex temporal dynamics. The cross-modal fusion mechanism enables more comprehensive market analysis and improved forecasting performance.},
  note={PDF: papers/2504.13522.pdf}
}

@article{wu2021autoformer,
  title={Autoformer: Long Range Forecasting with Auto-Correlation Attention},
  author={Wu, Haixu and Hu, Yuxuan and Liu, Jiehui and Zhou, Hengzhi and Xu, Min and Xu, Ronghui and Wu, Teng and Xie, Xiao-Yang},
  year={2021},
  eprint={2106.13008},
  archivePrefix={arXiv},
  primaryClass={cs.LG},
  journal={NeurIPS 2021},
  abstract={Autoformer is designed for long-range time series forecasting, featuring an Auto-Correlation mechanism that discovers period-based correlations and aggregates sub-series with shared information. This design achieves state-of-the-art performance on multiple time series benchmarks including weather prediction, electricity consumption, and financial data, significantly outperforming traditional Transformer models.},
  note={PDF: papers/2106.13008.pdf}
}

@article{lim2020temporal,
  title={Temporal Fusion Transformers for Interpretable Multi-Horizon Time Series Forecasting},
  author={Lim, Bryan and Zohren, Stephen},
  year={2020},
  eprint={1912.09363},
  archivePrefix={arXiv},
  primaryClass={cs.LG},
  abstract={The Temporal Fusion Transformer (TFT) is a novel architecture designed for multi-horizon time series forecasting with interpretability. TFT combines static covariate processing, gating mechanisms, and multi-horizon forecasting in a unified framework. The model provides interpretable insights through variable importance scores and attention patterns, making it particularly suitable for financial applications where model interpretability is crucial.},
  note={PDF: papers/1912.09363.pdf}
}

@article{zhou2021informer,
  title={Informer: Beyond Efficient Transformer for Long Sequence Time-Series Forecasting},
  author={Zhou, Haoyi and Zhang, Shanghang and Peng, Jieqi and Zhang, Shuai and Li, Jianxin and Xiong, Hui and Zhang, Wencen},
  year={2021},
  eprint={2012.07436},
  archivePrefix={arXiv},
  primaryClass={cs.LG},
  journal={AAAI 2021},
  abstract={Informer addresses the challenge of long sequence time-series forecasting (LSTF) with a dedicated Transformer architecture. Key contributions include a ProbSparse self-attention mechanism that achieves O(L log L) complexity, a distilling operation to highlight dominant attention, and a generative-style decoder for fast long sequence prediction. The model demonstrates excellent performance on financial time series with reduced computational cost.},
  note={PDF: papers/2012.07436.pdf}
}


@article{rigutini2023sortnet, title={SortNet: Learning To Rank by a Neural-Based Sorting Algorithm}, author={Rigutini, Leonardo and Papini, Tiziano and Maggini, Marco and Scarselli, Franco}, journal={arXiv preprint arXiv:2311.01864}, year={2023}, eprint={2311.01864}, archivePrefix={arXiv}, primaryClass={cs.LG}, abstract={本文提出SortNet，一种基于神经网络的排序算法，使用神经网络作为比较器来排序对象。算法采用迭代训练过程，每次迭代添加最具信息量的训练样本。SortNet在LETOR数据集上展示了良好的性能，适用于用户偏好不同的排序任务。}, pdf={papers/sortnet_neural_ranking_2311.01864.pdf}}

@article{qiu2022ndcg, title={Large-scale Stochastic Optimization of NDCG Surrogates for Deep Learning with Provable Convergence}, author={Qiu, Zi-Hao and Hu, Quanqi and Zhong, Yongjian and Zhang, Lijun and Yang, Tianbao}, journal={arXiv preprint arXiv:2202.12183}, year={2022}, eprint={2202.12183}, archivePrefix={arXiv}, primaryClass={cs.LG}, abstract={本文提出了一种原则性方法来优化NDCG及其top-K变体，将NDCG代理优化表述为一个组合优化问题，开发了具有可证明收敛保证的高效随机算法，per-iteration复杂度与mini-batch大小成正比。实验表明方法在NDCG方面优于先前排序方法。}, pdf={papers/ndcg_optimization_deep_learning_2202.12183.pdf}}

@article{lucchese2022ilmart, title={ILMART: Interpretable Ranking with Constrained LambdaMART}, author={Lucchese, Claudio and Nardini, Franco Maria and Orlando, Salvatore and Perego, Raffaele and Veneri, Alberto}, journal={arXiv preprint arXiv:2206.00473}, year={2022}, eprint={2206.00473}, archivePrefix={arXiv}, primaryClass={cs.IR}, abstract={本文提出ILMART，一种基于LambdaMART的可解释排序解决方案，通过利用有限且受控数量的成对特征交互来训练有效且可解释的排序模型。在三个公开可用的LtR数据集上的实验表明，ILMART在nDCG方面比当前最先进的可解释排序方法高出8%。}, pdf={papers/ilmart_interpretable_lambdamart_2206.00473.pdf}}

@article{an2023spatialrank, title={SpatialRank: Urban Event Ranking with NDCG Optimization on Spatiotemporal Data}, author={An, Bang and Zhou, Xun and Zhong, Yongjian and Yang, Tianbao}, journal={arXiv preprint arXiv:2310.00270}, year={2023}, eprint={2310.00270}, archivePrefix={arXiv}, primaryClass={cs.LG}, abstract={本文提出SpatialRank，一种新颖的城市事件排序方法，通过自适应图卷积层动态学习位置间的时空依赖性，优化带有空间分量的混合NDCG损失。在三个真实数据集上的实验表明，SpatialRank在NDCG方面优于最新方法达12.7%。}, pdf={papers/spatialrank_ndcg_urban_2310.00270.pdf}}


